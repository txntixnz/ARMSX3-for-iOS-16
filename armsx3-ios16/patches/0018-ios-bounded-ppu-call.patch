+extern "C" int armsx3_ios_ppu_call_bounded(ppu_thread* context, u32 begin, u32 end, u64 rtoc, u32 return_addr, u32 budget)
+{
+	if (!context || begin >= end || begin % 4 || end % 4 || !return_addr || return_addr % 4 ||
+		return_addr > 0xfffffffbu || (return_addr >= begin && return_addr < end) || !budget || budget > 4096 ||
+		g_cfg.core.ppu_decoder != ppu_decoder_type::_static || !g_fxo->is_init<ppu_function_manager>() ||
+		g_fxo->get<ppu_function_manager>().func_addr(1, true) != return_addr || !context->cia ||
+		context->loaded_from_savestate || context->state & cpu_flag::ret) return -4;
+	const auto cia = context->cia;
+	const auto toc = context->gpr[2];
+	const auto lr = context->lr;
+	const auto function = context->current_function;
+	const auto prefix = g_tls_log_prefix;
+	ios_ppu_dispatch_probe probe{begin, end, budget};
+	probe.return_addr = return_addr;
+	struct Restore { ios_ppu_dispatch_probe* previous = s_ios_ppu_dispatch_probe;
+		~Restore() { s_ios_ppu_dispatch_probe = previous; } } restore;
+	s_ios_ppu_dispatch_probe = &probe;
+	context->fast_call(begin, rtoc);
+	if (context->cia != cia || context->gpr[2] != toc || context->lr != lr ||
+		context->current_function != function || g_tls_log_prefix != prefix || context->state & cpu_flag::ret) return -5;
+	return probe.result;
+}
