+// Only the statistics destination is scoped here. The SC interpreter,
+// production table, bindings and system-service handlers remain unchanged.
+struct ios_ppu_syscall_probe { std::array<u32, 1024> counts{}; };
+static thread_local ios_ppu_syscall_probe* s_ios_ppu_syscall_probe = nullptr;
+extern "C" int armsx3_ios_ppu_probe_syscalls_and_call(ppu_thread* context,
+    int (*execute)(ppu_thread*, void*), void* user)
+{
+	if (!context || !execute || !Emu.IsStopped() || cpu_thread::get_current() != context ||
+		g_cfg.core.ppu_decoder != ppu_decoder_type::_static || context->stack_addr != 0x30000u ||
+		context->stack_size != 0x8000u || context->entry_func.addr != 0x10000u) return -1;
+	if (s_ios_ppu_syscall_probe) return -2;
+	ios_ppu_syscall_probe probe;
+	struct Restore { ~Restore() { s_ios_ppu_syscall_probe = nullptr; } } restore;
+	s_ios_ppu_syscall_probe = &probe;
+	const int result = execute(context, user);
+	if (result < 0) return result;
+	for (u32 code = 0; code < probe.counts.size(); ++code)
+		if (probe.counts[code] != (code == 46 ? 2u : (code == 49 || code == 6 ? 1u : 0u))) return -3;
+	return result;
+}
