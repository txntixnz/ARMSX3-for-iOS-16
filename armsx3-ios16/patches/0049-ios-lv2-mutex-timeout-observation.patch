+
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+int lv2_obj::ios_probe_mutex_timeout_state(ppu_thread* waiter, ppu_thread* holder, u64 timeout)
+{
+    if (!waiter || !holder || waiter == holder || !timeout || cpu_thread::get_current() != holder || !Emu.IsStopped()) return -1;
+    std::lock_guard lock(g_mutex);
+    // Read deadline fields under the same native scheduler mutex used for
+    // sleep registration/removal. No guest registers or clocks are modified.
+    return g_scheduler_ready && !g_pending && g_to_sleep.empty() && g_waiting.size() == 1 &&
+        g_waiting.front().second == waiter && g_waiting.front().first == waiter->end_time &&
+        waiter->end_time != umax && waiter->end_time >= waiter->start_time &&
+        waiter->end_time - waiter->start_time == timeout &&
+        g_ppu == holder && !holder->next_ppu && !waiter->next_ppu && !waiter->next_cpu &&
+        waiter->state.all_of(cpu_flag::wait + cpu_flag::suspend) &&
+        waiter->state.none_of(cpu_flag::signal + cpu_flag::again + cpu_flag::exit + cpu_flag::notify) ? 1 : 0;
+}
+extern "C" int armsx3_ios_ppu_probe_mutex_timeout_state(ppu_thread* waiter, ppu_thread* holder, u64 timeout)
+{
+    return lv2_obj::ios_probe_mutex_timeout_state(waiter, holder, timeout);
+}
+#endif
+#if defined(__APPLE__) && TARGET_OS_IPHONE
+int lv2_obj::ios_probe_mutex_timeout_finished(ppu_thread* waiter, ppu_thread* holder)
+{
+    const auto current = cpu_thread::get_current();
+    if (!waiter || !holder || waiter == holder || (current != waiter && current != holder) || !Emu.IsStopped()) return -1;
+    std::lock_guard lock(g_mutex);
+    const bool pair = (g_ppu == holder && holder->next_ppu == waiter && !waiter->next_ppu) ||
+        (g_ppu == waiter && waiter->next_ppu == holder && !holder->next_ppu);
+    return g_scheduler_ready && !g_pending && g_waiting.empty() && g_to_sleep.empty() && pair &&
+        !waiter->next_cpu && !holder->next_cpu &&
+        waiter->state.none_of(cpu_flag::suspend + cpu_flag::signal + cpu_flag::again + cpu_flag::exit + cpu_flag::notify) &&
+        holder->state.none_of(cpu_flag::suspend + cpu_flag::signal + cpu_flag::again + cpu_flag::exit + cpu_flag::notify) ? 1 : 0;
+}
+extern "C" int armsx3_ios_ppu_probe_mutex_timeout_finished(ppu_thread* waiter, ppu_thread* holder)
+{
+    return lv2_obj::ios_probe_mutex_timeout_finished(waiter, holder);
+}
+#endif
