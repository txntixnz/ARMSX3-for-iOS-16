+#if defined(__APPLE__) && TARGET_OS_IPHONE
+// Publish executable process metadata only after the bounded input succeeds.
+extern "C" int armsx3_ios_ppu_read_probe_process_parameters(const ppu_exec_object::prog_t* prog, u32* parameters)
+{
+	if (!prog || !parameters || !Emu.IsStopped() || prog->p_type != 0x60000001u ||
+		prog->p_vaddr != 0x20140u || prog->p_flags || prog->p_filesz != 32u ||
+		prog->p_memsz != 32u || prog->bin.size() != 32u) return -1;
+	u32 sdk = SYS_PROCESS_PARAM_SDK_VERSION_UNKNOWN, stack = SYS_PROCESS_PARAM_STACK_SIZE_MAX;
+	u32 page = SYS_PROCESS_PARAM_MALLOC_PAGE_SIZE_1M, ppc = 0;
+	s32 priority = 1001;
+	if (!ppu_read_exec_process_parameters(*prog, sdk, priority, stack, page, ppc)) return -2;
+	// The normal parser retains its default/warning behavior. This diagnostic
+	// accepts only its known private stack, page size and process configuration.
+	const auto* bytes = prog->bin.data();
+	if (bytes[0] || bytes[1] || bytes[2] || bytes[3] != 32 ||
+		sdk != 0x00360001u || priority != 1100 || stack != 0x8000u || page != 0x10000u || ppc) return -3;
+	const std::array<u32, 5> result{sdk, static_cast<u32>(priority), stack, page, ppc};
+	std::copy(result.begin(), result.end(), parameters);
+	return 0;
+}
+#endif
