+void VKGSRender::reclaim_texture_cache()
+{
+#if defined(__APPLE__) && TARGET_OS_IOS
+	// Budget/reclaim BEFORE sampler/cache locks. Allocation-time recovery cannot
+	// evict clean sections when it re-enters a cache already held by this thread.
+	if (vk::is_uninterruptible() ||
+		(m_queue_status & flush_queue_state::flushing) ||
+		(m_queue_status & flush_queue_state::deadlock))
+	{
+		return;
+	}
+
+	ensure(is_current_thread());
+	constexpr u64 mb = 0x100000;
+	const auto before = vk::vmm_get_application_pool_usage(VMM_ALLOCATION_POOL_TEXTURE_CACHE);
+	if (before < m_ios_texture_cache_next_check) return;
+
+	if (!m_texture_cache.is_overallocated())
+	{
+		m_ios_texture_cache_next_check = before + 16 * mb;
+		return;
+	}
+
+	// Native fatal-pressure reclamation submits/waits all prior work, preserves
+	// textures referenced by current guest registers and purges discarded entries.
+	// Drain again afterward: deletion queued during eviction must actually finish
+	// before the next allocation, even in a long load without a present.
+	const bool relieved = on_vram_exhausted(rsx::problem_severity::fatal);
+	g_fxo->get<vk::driver_manager_thread>().drain();
+	m_samplers_dirty.store(true);
+	const auto after = vk::vmm_get_application_pool_usage(VMM_ALLOCATION_POOL_TEXTURE_CACHE);
+
+	// If the live set cannot shrink, do not hard-sync on every draw. Recheck after
+	// another 16 MiB of growth, or at the normal 192 MiB watermark after a purge.
+	m_ios_texture_cache_next_check = std::max<u64>(192 * mb, after + 16 * mb);
+	rsx_log.warning("iOS: texture-cache budget pass %lluM -> %lluM (released=%d).",
+		before / mb, after / mb, static_cast<int>(relieved));
+#endif
+}
