+#if defined(__APPLE__) && TARGET_OS_IOS
+	std::atomic<const void*> g_ios_timing_owner{nullptr};
+
+	void begin_ios_timing()
+	{
+		// Called on the new RSX worker, before it enters any measured scopes.
+		// Always reset: pthread identities may be reused by a later session.
+		g_acc = {};
+		g_acc.window_start = utils::get_tsc();
+		g_last_switch = g_acc.window_start;
+		g_current = bucket::unclassified;
+		g_ios_timing_owner.store(current_thread_token(), std::memory_order_relaxed);
+		prof_log.success("iOS RSX timing started; exclusive wall time only; guest sampler disabled");
+	}
+
+	void report_ios_timing(bool finishing)
+	{
+		if (!timing_enabled()) return;
+		const u64 now = utils::get_tsc();
+		const u64 freq = utils::get_tsc_freq();
+		const u64 elapsed = now - g_acc.window_start;
+		if (!freq || !elapsed || (!finishing && elapsed < freq * 10)) return;
+
+		// Flush the current bucket before reporting. Nested scopes retain their
+		// enclosing bucket across the reset, so no interval is counted twice.
+		switch_to(g_current);
+		std::string detail;
+		for (usz i = 0; i < bucket_count; ++i)
+		{
+			const double percent = 100.0 * g_acc.ticks[i] / elapsed;
+			if (percent >= 0.5)
+				fmt::append(detail, "; %s=%.1f%%", name_of(static_cast<bucket>(i)), percent);
+		}
+		const double wall_ms = 1000.0 * elapsed / freq;
+		prof_log.success("iOS RSX timing: frames=%u; wall=%.1f ms; avg=%.1f ms; final=%u%s",
+			g_acc.frames, wall_ms, g_acc.frames ? wall_ms / g_acc.frames : 0.0,
+			finishing ? 1u : 0u, detail);
+
+		// Exclude reporting/log-writing time from the next measurement window.
+		g_acc = {};
+		g_acc.window_start = utils::get_tsc();
+		g_last_switch = g_acc.window_start;
+	}
+
+	void end_ios_timing()
+	{
+		if (!timing_enabled()) return;
+		report_ios_timing(true);
+		g_ios_timing_owner.store(nullptr, std::memory_order_relaxed);
+	}
+#endif
+
