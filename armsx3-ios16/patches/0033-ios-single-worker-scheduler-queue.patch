+#if defined(__APPLE__) && TARGET_OS_IPHONE
+// Exercise the production single-worker running queue while the scheduler
+// remains stopped. Normal admission/reordering and service code is unchanged.
+int lv2_obj::ios_probe_scheduler_queue_and_call(ppu_thread* context,
+    int (*execute)(ppu_thread*, void*), void* user)
+{
+    if (!context || !execute || !Emu.IsStopped() || cpu_thread::get_current() != context ||
+        g_cfg.core.ppu_decoder != ppu_decoder_type::_static || context->stack_addr != 0x30000u ||
+        context->stack_size != 0x8000u || context->entry_func.addr != 0x10000u ||
+        g_cfg.core.ppu_threads + 0u < 1u) return -1;
+    if (s_ios_ppu_syscall_probe) return -2;
+    const auto isolated = [context]() {
+        return !g_pending && !g_scheduler_ready && g_waiting.empty() && g_to_sleep.empty() &&
+            g_to_awake.empty() && !g_postpone_notify_barrier && !s_yield_frequency &&
+            std::all_of(std::begin(g_to_notify), std::end(g_to_notify), [](const void* p) { return !p; }) &&
+            !context->next_ppu && !context->res_notify && !context->ack_suspend &&
+            !context->hw_sleep_time && !context->start_time && !context->cancel_sleep &&
+            cpu_flag::suspend - context->state;
+    };
+    ppu_thread::ppu_prio_t previous{};
+    u64 tag = 0;
+    {
+        std::lock_guard lock(g_mutex);
+        if (g_ppu || !isolated() || context->prio.load().prio != 1100 ||
+            ppu_state(context, false, false).first != PPU_THREAD_STATUS_STOP) return -4;
+        previous = context->prio.load(); tag = g_priority_order_tag.load();
+    }
+    struct Restore {
+        ppu_thread* context; ppu_thread::ppu_prio_t previous; u64 tag;
+        ~Restore() {
+            std::lock_guard lock(g_mutex);
+            lv2_obj::unqueue(g_ppu, context, &ppu_thread::next_ppu);
+            context->prio = previous; g_priority_order_tag = tag;
+        }
+    } restore{context, previous, tag};
+    // Public awake() follows the unchanged enqueue path, without making the
+    // normal scheduler ready or resuming another emulation worker.
+    if (!awake(context)) return -6;
+    {
+        std::lock_guard lock(g_mutex);
+        if (g_ppu != context || !isolated() || count_non_sleeping_threads().onproc_count != 1 ||
+            ppu_state(context, false, false) != std::pair{PPU_THREAD_STATUS_ONPROC, 0u}) return -6;
+    }
+    // Same ten service calls as P37, now operating on an admitted worker.
+    const int result = ppu_probe_syscalls_and_call(context, execute, user, 2);
+    if (result < 0) return result;
+    {
+        std::lock_guard lock(g_mutex);
+        if (g_ppu != context || !isolated() || context->prio.load().all != previous.all ||
+            g_priority_order_tag.load() != tag || count_non_sleeping_threads().onproc_count != 1 ||
+            ppu_state(context, false, false) != std::pair{PPU_THREAD_STATUS_ONPROC, 0u}) return -5;
+    }
+    return result;
+}
+extern "C" int armsx3_ios_ppu_probe_scheduler_queue_and_call(ppu_thread* context,
+    int (*execute)(ppu_thread*, void*), void* user)
+{
+    return lv2_obj::ios_probe_scheduler_queue_and_call(context, execute, user);
+}
+#endif
