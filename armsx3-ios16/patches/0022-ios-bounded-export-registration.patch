+	{
+		std::lock_guard lock(global.mutex);
+		if (global.modules.contains("iOSProbe")) return -5;
+	}
+	{
+		std::lock_guard lock(global.lib_lock_mutex);
+		if (global.lib_lock.contains("iOSProbe")) return -5;
+	}
+	struct Cleanup
+	{
+		const ppu_module<lv2_obj>& info;
+		ppu_linkage_info& global;
+		u32 first, second, original;
+		bool active = true;
+		void release()
+		{
+			if (!active) return;
+			info.get_ref<u32>(first) = original;
+			info.get_ref<u32>(second) = original;
+			std::lock_guard lock(global.lib_lock_mutex);
+			global.lib_lock.erase("iOSProbe");
+			active = false;
+		}
