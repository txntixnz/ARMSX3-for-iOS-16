+// Exercise the production import/export linkers, including deferred backpatch.
+// Function links are local; the production library lock is owned and removed.
+extern "C" int armsx3_ios_ppu_register_probe_exports(const ppu_module<lv2_obj>* info, u32 start)
+{
+	if (!info || !Emu.IsStopped() || info->segs.size() != 2 ||
+		start != info->segs[1].addr + 192 || info->segs[1].size != 256 ||
