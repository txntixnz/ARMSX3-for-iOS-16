+	const u32 data = info->segs[1].addr, first = data + 176, second = first + 4;
+	const auto& lib = info->get_ref<const ppu_prx_module_info>(data + 64);
+	if (lib.size != sizeof(ppu_prx_module_info) || lib.num_func != 2 || lib.num_var || lib.num_tlsvar ||
+		lib.attributes || lib.name.addr() != data + 128 || lib.nids.addr() != data + 160 || lib.addrs.addr() != first ||
