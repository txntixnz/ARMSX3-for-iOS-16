+	auto& known = local.modules.at("iOSProbe").functions.at(0x49524e31);
+	auto& unknown = local.modules.at("iOSProbe").functions.at(0x49524e32);
+	if (imports.size() != 2 || imports.at(first) != &known || imports.at(second) != &unknown ||
+		uses.size() != 2 || uses.at(0x49524e31) != info->segs[0].addr || uses.at(0x49524e32) != info->segs[0].addr ||
+		!relocs.empty() || known.export_addr || unknown.export_addr ||
+		known.imports.size() != 1 || !known.imports.contains(first) ||
+		unknown.imports.size() != 1 || !unknown.imports.contains(second) ||
