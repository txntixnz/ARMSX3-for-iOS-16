+		known.export_addr != data || unknown.export_addr || known.static_func || known.static_var ||
+		!known.frefss.empty() || !unknown.frefss.empty() ||
+		info->get_ref<u32>(first) != data || info->get_ref<u32>(second) != manager.addr) return -7;
+	{
+		std::lock_guard lock(global.lib_lock_mutex);
+		const auto it = global.lib_lock.find("iOSProbe");
+		if (it == global.lib_lock.end() || !it->second.load()) return -8;
+	}
+	// Reuse the production unload path to release the library lock.
+	const auto unloaded = ppu_load_exports(*info, &local, start, start + sizeof(ppu_prx_module_info), false, nullptr, &flags);
+	if (!unloaded.empty()) return -9;
+	{
+		std::lock_guard lock(global.lib_lock_mutex);
+		const auto it = global.lib_lock.find("iOSProbe");
