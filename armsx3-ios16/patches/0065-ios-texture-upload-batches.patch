+void VKGSRender::reclaim_texture_uploads()
+{
+#if defined(__APPLE__) && TARGET_OS_IOS
+	// Called before texture-cache/sampler locks and outside upload recording.
+	// A long load may not present, so submit bounded batches explicitly.
+	// Completion returns space through the existing command-buffer snapshot.
+	if (vk::is_uninterruptible() ||
+		(m_queue_status & flush_queue_state::flushing) ||
+		(m_queue_status & flush_queue_state::deadlock) ||
+		!m_texture_upload_buffer_ring_info.heap ||
+		m_texture_upload_buffer_ring_info.pending_bytes() < 32 * 0x100000)
+	{
+		return;
+	}
+
+	ensure(is_current_thread());
+	const auto bytes = m_texture_upload_buffer_ring_info.pending_bytes();
+	auto* submitted = m_current_command_buffer;
+	flush_command_queue();
+	CHECK_RESULT(submitted->wait(FRAME_PRESENT_TIMEOUT));
+	rsx_log.warning("iOS: completed texture upload batch (%lluK); pending %lluK.",
+		static_cast<u64>(bytes / 1024),
+		static_cast<u64>(m_texture_upload_buffer_ring_info.pending_bytes() / 1024));
+#endif
+}
