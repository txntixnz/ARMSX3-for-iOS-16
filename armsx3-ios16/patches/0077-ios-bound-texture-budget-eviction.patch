+#if defined(__APPLE__) && TARGET_OS_IOS
+		template <typename GetBytes>
+		u64 evict_unused_budgeted(const std::set<u32>& exclusion_list, u64 target_bytes, GetBytes&& get_bytes)
+		{
+			ensure(rsx::get_current_renderer()->is_current_thread());
+			if (!target_bytes) return 0;
+			std::unique_lock lock(m_cache_mutex, std::defer_lock);
+			if (!lock.try_lock()) return 0;
+
+			struct candidate
+			{
+				section_storage_type* section;
+				u64 last_use;
+				u64 bytes;
+			};
+			std::vector<candidate> candidates;
+			const u32 types = rsx::texture_upload_context::shader_read | rsx::texture_upload_context::blit_engine_src;
+			for (auto& block : m_storage)
+			{
+				for (auto& region : block)
+				{
+					if (region.is_dirty() || !(region.get_context() & types) ||
+						!region.exists() || !region.is_managed() ||
+						exclusion_list.contains(region.get_section_base()))
+					{
+						continue;
+					}
+					ensure(region.is_locked());
+					if (const u64 bytes = get_bytes(region))
+					{
+						candidates.push_back({&region, region.ios_last_use_tag.load(), bytes});
+					}
+				}
+			}
+			std::stable_sort(candidates.begin(), candidates.end(), [](const candidate& a, const candidate& b)
+			{
+				return a.last_use < b.last_use;
+			});
+
+			// Keep page protections of retained sections intact. In particular,
+			// textures/FBOs may share locked pages despite different base addresses.
+			u64 selected_bytes = 0;
+			for (const auto& entry : candidates)
+			{
+				auto& region = *entry.section;
+				if (region.is_locked(true))
+				{
+					bool shared_pages = false;
+					for (auto& block : m_storage)
+					{
+						for (auto& other : block)
+						{
+							if (&other != &region && other.is_locked(true) &&
+								other.get_locked_range().overlaps(region.get_locked_range()))
+							{
+								shared_pages = true;
+								break;
+							}
+						}
+						if (shared_pages) break;
+					}
+					if (shared_pages) continue;
+				}
+
+				if (region.is_locked(true)) region.unprotect();
+				else region.discard(true);
+				region.set_dirty(true); // Update unreleased accounting after unlocking, including blit sources.
+				selected_bytes += entry.bytes;
+				if (selected_bytes >= target_bytes) break;
+			}
+			return selected_bytes;
+		}
+#endif
