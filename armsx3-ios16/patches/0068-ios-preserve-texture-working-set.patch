 	ensure(is_current_thread());
 	constexpr u64 mb = 0x100000;
+	constexpr u64 watermark = 288 * mb;
+	constexpr u64 idle_reserve = 32 * mb;
 	const auto before = vk::vmm_get_application_pool_usage(VMM_ALLOCATION_POOL_TEXTURE_CACHE);
 	if (before < m_ios_texture_cache_next_check) return;
 
+	// Pool usage includes completed images awaiting reuse, not just cached
+	// content. Free those first: evicting clean textures to recover idle memory
+	// discards useful pixels and made the phone reupload ~60 GiB in six minutes.
+	const auto idle_freed = m_texture_cache.trim_reusable_images(idle_reserve);
+	const auto trimmed = vk::vmm_get_application_pool_usage(VMM_ALLOCATION_POOL_TEXTURE_CACHE);
 	if (!m_texture_cache.is_overallocated())
 	{
