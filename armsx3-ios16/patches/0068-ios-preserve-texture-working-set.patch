diff --git a/rpcs3/Emu/RSX/VK/VKTextureCache.cpp b/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
--- a/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
+++ b/rpcs3/Emu/RSX/VK/VKTextureCache.cpp
@@ -1862,6 +1862,23 @@
 		return m_cached_memory_size;
 	}
 
+	u64 texture_cache::trim_reusable_images(u64 keep_bytes)
+	{
+		// Only GPU-completed, content-free images enter this pool via
+		// cached_image_reference_t destruction. Retain the newest small reuse
+		// reserve and delete old idle allocations, as on_frame_end already does.
+		std::lock_guard lock(m_cached_pool_lock);
+		u64 released = 0;
+		while (!m_cached_images.empty() && m_cached_memory_size > keep_bytes)
+		{
+			const auto bytes = m_cached_images.back().data->memory->size();
+			m_cached_memory_size -= bytes;
+			released += bytes;
+			m_cached_images.pop_back();
+		}
+		return released;
+	}
+
 	bool texture_cache::is_overallocated() const
 	{
 		const auto total_device_memory = vk::get_budgetable_device_memory(m_device->get_memory_mapping().device_local_total_bytes) / 0x100000;
@@ -1885,9 +1902,9 @@
 		}
 
 #if defined(__APPLE__) && TARGET_OS_IOS
-		// A15 shares graphics memory with guest RAM, rings and the driver. Keep
-		// cached textures below the late 440 MiB refusal observed on the phone.
-		quota = std::min<u64>(quota, 192);
+		// Leave room below the observed 440 MiB refusal while retaining the
+		// scene's working set. Reclaim completed idle images before live content.
+		quota = std::min<u64>(quota, 288);
 #endif
 		quota *= 0x100000;
 
